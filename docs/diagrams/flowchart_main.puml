@startuml flowchart_main
title Блок-схема 4.1. Главный алгоритм моделирования\n(вариант 27: ИБ ИЗ2 ПЗ1 Д1ОЗ3 Д1ОО5 Д2П1 Д2Б4 ОР1 ОД3)
skinparam shadowing false
skinparam defaultFontSize 13
skinparam ActivityBorderColor #444444
skinparam ActivityBackgroundColor #F7F9FC
skinparam swimlaneTitleFontStyle bold
skinparam ArrowColor #333333

|Симулятор|
start
:Ввод параметров: ёмкость буфера K, число движков M,
законы источников U[a₁,b₁] и U[a₂,b₂],
интенсивности обслуживания μ₁…μ_M;
:N := N₀ = 100 (первая «пристрелка»);

repeat
  :Инициализация: t = 0, буфер пуст,
  все движки свободны, счётчики и статистика обнулены;
  |Источники|
  :Запланировать первое ORDER_ARRIVAL
  каждого источника: И1 (VIP) и И2 (Standard);
  |Симулятор|
  while (Календарь событий не пуст?) is (да)
    :Извлечь ближайшее событие,
    модельное время t := время события;
    if (Тип события?) then (ORDER_ARRIVAL)
      |Диспетчер постановки (ДП)|
      :Поступление ордера
      (блок-схема 4.2);
    else (ORDER_COMPLETED)
      |Диспетчер выбора (ДВ)|
      :Завершение исполнения
      (блок-схема 4.3);
    endif
    |Вывод|
    if (Пошаговый режим?) then (да)
      :Зафиксировать состояние после события —
      очередной шаг временной диаграммы (ОД3);
    endif
    |Симулятор|
  endwhile (нет)
  :T_реал := момент выхода последней заявки из системы;
  :Рассчитать p_отк, T_БП, T_обсл, T_преб, Д_БП, Д_обсл, K_исп;
  :Уточнить N = t²·(1 − p) / (p·δ²),
  где t = 1,643, δ = 0,1;
repeat while (|p_пред − p_тек| ≥ 0,1·p_пред?) is (да) not (нет)

|Вывод|
:Сформировать сводные таблицы результатов (ОР1):
характеристики источников и коэффициенты использования движков;
stop
@enduml
