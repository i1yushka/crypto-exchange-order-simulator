@startuml flowchart_completion
title Блок-схема 4.3. Обработка события ORDER_COMPLETED (завершение исполнения)\nвыбор ордера из буфера — Д2Б4
skinparam shadowing false
skinparam defaultFontSize 13
skinparam ActivityBorderColor #444444
skinparam ActivityBackgroundColor #F7F9FC
skinparam swimlaneTitleFontStyle bold
skinparam ArrowColor #333333

|Движок исполнения|
start
:Событие ORDER_COMPLETED: движок j, момент t;
:t_кон := t, T_обсл := t_кон − t_нач,
T_преб := t_кон − t_пост, освободить движок j,
накопить время занятости движка j;

|Статистика|
:Записать результат: ордер исполнен,
добавить T_ож, T_обсл, T_преб в статистику источника;

|Диспетчер выбора (ДВ)|
if (Буфер пуст?) then (да)
  :Движок j простаивает
  до следующего поступления ордера;
else (нет)
  :Среди ордеров в буфере найти ордера
  с наименьшим номером источника (Д2Б4);
  if (Таких ордеров несколько?) then (да)
    :Выбрать последний поступивший
    (максимальное t_пост);
  else (нет)
    :Выбрать единственный ордер;
  endif
  |Буфер|
  :Извлечь выбранный ордер, освободить его ячейку,
  остальные ордера остаются на своих местах;
  |Движок исполнения|
  :Занять движок j: t_нач := t, T_ож := t − t_пост,
  разыграть T_обсл ~ Exp(μ_j),
  запланировать ORDER_COMPLETED в момент t + T_обсл;
endif

|Симулятор|
:Вернуться в главный цикл (4.1);
stop
@enduml
