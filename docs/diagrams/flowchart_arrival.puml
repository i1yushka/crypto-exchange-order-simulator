@startuml flowchart_arrival
title Блок-схема 4.2. Обработка события ORDER_ARRIVAL (поступление ордера)\nД2П1 → Д1ОЗ3 → Д1ОО5
skinparam shadowing false
skinparam defaultFontSize 13
skinparam ActivityBorderColor #444444
skinparam ActivityBackgroundColor #F7F9FC
skinparam swimlaneTitleFontStyle bold
skinparam ArrowColor #333333

|Источник|
start
:Событие ORDER_ARRIVAL: источник i, момент t;
:Сформировать ордер (i.j), t_пост := t,
счётчик сгенерированных ордеров источника i += 1;
if (Сгенерировано ордеров < N?) then (да)
  :Разыграть интервал Δ ~ U[a_i, b_i],
  запланировать следующее ORDER_ARRIVAL
  источника i в момент t + Δ;
else (нет)
  :Источник i больше не генерирует ордера;
endif

|Диспетчер постановки (ДП)|
:Поиск свободного движка перебором
П1, П2, … начиная с П1 (Д2П1);
if (Есть свободный движок?) then (да)
  |Движок исполнения|
  :Занять движок j: t_нач := t, T_ож := 0,
  разыграть T_обсл ~ Exp(μ_j),
  запланировать ORDER_COMPLETED в момент t + T_обсл;
else (нет)
  |Буфер|
  :Просмотр ячеек буфера с первой (Д1ОЗ3);
  if (Есть свободная ячейка?) then (да)
    :Поместить ордер в первую свободную ячейку,
    сдвига остальных ордеров нет;
  else (нет)
    |Статистика|
    :Отказ (Д1ОО5): новый ордер отклоняется
    (ORDER_REJECTED: queue full),
    буфер не изменяется, отказы источника i += 1;
  endif
endif

|Симулятор|
:Вернуться в главный цикл (4.1);
stop
@enduml
